#!/usr/bin/env bash
# 模板维护者 pre-push 保护（安装：cp scripts/hooks/pre-push .git/hooks/ && chmod +x .git/hooks/pre-push）
# 规则：推往「发布远端」的任何 ref，内容必须在 template 历史内——杜绝把实例分支（个人
# 内容）推上模板仓，无论命令行还是 IDE 按钮；含 template 的 ref 另跑 release-check 敏感扫描。
# 发布远端来自本地配置（不入库）：git config --add llmwiki.release-remote <远端名>；未配置时默认 origin。
remote="$1"
PROTECTED=$(git config --get-all llmwiki.release-remote || true)
[ -z "$PROTECTED" ] && PROTECTED="origin"
echo "$PROTECTED" | grep -qx "$remote" || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    commit=$(git rev-parse "$local_sha^{commit}" 2>/dev/null) || continue
    if ! git merge-base --is-ancestor "$commit" refs/heads/template; then
        echo "✗ 阻断：$local_ref 不在 template 历史内——发布远端「$remote」只接受模板内容。"
        echo "  发布模板请用 scripts/release.sh。"
        exit 1
    fi
    case "$local_ref" in *template*)
        ./scripts/release-check.sh template || { echo "✗ 发布被阻断（release-check 未过）。"; exit 1; } ;;
    esac
done
exit 0
