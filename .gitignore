.DS_Store
__pycache__/
*.pyc
*.tmp
*.bak
# 分析用仓库克隆，不入库
repos/*
!repos/.gitkeep
# Claude 本机配置，含绝对路径，不入库
.claude/settings.local.json
# 私有区：涉他评价、绩效、薪酬、未公开事项，物理不出本机（README 仍入库）
wiki/private/*
!wiki/private/README.md
# 采集游标本机私有；产出水位线若有则入 Git
state/collectors/
# 任务 worktree（开发纪律要求，不入库）
.worktrees/
.release-check-local
